# Copy to .env.local and fill in. Only VITE_* values reach the browser, so never
# put a secret key here — the Razorpay key SECRET lives in the server function.

# Public site URL, used for canonical links, Open Graph and the sitemap
VITE_SITE_URL=https://aakaar.example

# Razorpay public key id (rzp_test_... or rzp_live_...). Leave empty for demo checkout.
VITE_RAZORPAY_KEY_ID=
# Base URL of the deployed server functions, e.g. https://<project>.supabase.co/functions/v1
VITE_API_BASE=

# Business WhatsApp number with country code, digits only (e.g. 9198XXXXXXXX).
# Leave empty to hide every WhatsApp button.
VITE_WHATSAPP_NUMBER=
